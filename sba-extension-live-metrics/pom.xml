<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.alexmond</groupId>
        <artifactId>spring-boot-admin-extensions</artifactId>
        <version>4.1.1.1-SNAPSHOT</version>
    </parent>

    <artifactId>sba-extension-live-metrics</artifactId>
    <name>sba-extension-live-metrics</name>
    <description>SBA custom UI: a "Live Metrics" page — replicates the standard Metrics view but
        renders each selected metric as a live, rolling time-series line chart (like the CPU/Memory
        graphs on the Overview page) instead of a one-shot value. The user picks an instance + metric
        (+ optional tag filters) and adds a graph; graphs poll the instance's actuator on an interval,
        can be removed, and persist across reloads via localStorage. Built with Vite/Vue and shipped
        as a resources jar under META-INF/spring-boot-admin-server-ui/extensions/live-metrics.</description>

    <build>
        <plugins>
            <!-- Build the Vue extension with a self-contained Node/npm (downloaded, not required
                 on PATH), then Vite bundles src/index.js -> target/dist/live-metrics-ui.js. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <configuration>
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <installDirectory>${project.build.directory}</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                            <npmVersion>${npm.version}</npmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <!-- ci = reproducible install from the committed package-lock.json. -->
                            <arguments>ci --no-progress --no-audit --no-fund</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Copy the Vite bundle into the SBA extensions classpath location so the admin
                 server serves it. The 'live-metrics' segment is this extension's folder name. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-ui-bundle</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/spring-boot-admin-server-ui/extensions/live-metrics</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
