<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.alexmond</groupId>
    <artifactId>spring-boot-admin-extensions</artifactId>
    <version>4.1.1.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>spring-boot-admin-extensions</name>
    <description>A small collection of extensions for Spring Boot Admin (SBA): custom UI pages
        shipped as classpath resource jars, and backend/SPI extensions such as a resilient
        Redis-backed InstanceEventStore. Drop the ones you want on the SBA server's classpath.</description>
    <url>https://github.com/alexmond/spring-boot-admin-extensions</url>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Alex Mondshain</name>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/alexmond/spring-boot-admin-extensions.git</connection>
        <developerConnection>scm:git:git@github.com:alexmond/spring-boot-admin-extensions.git</developerConnection>
        <url>https://github.com/alexmond/spring-boot-admin-extensions</url>
    </scm>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <modules>
        <module>sba-extension-environments</module>
        <module>sba-extension-live-metrics</module>
        <module>sba-extension-store-redis</module>
        <module>sample-admin-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Spring Boot Admin server/client — tracks the Boot minor line (SBA 4.1.x ↔ Boot 4.1.x).
             4.1.3 is the minimum worth building against: it fixes GHSA-4jg4-pqcq-xf3x (stored XSS).
             It also breaks the extension addView API (codecentric/spring-boot-admin#5724) — the UI
             modules work around that in src/register-view.js. -->
        <spring-boot-admin.version>4.1.3</spring-boot-admin.version>
        <!-- Frontend toolchain for the SBA UI extensions — node/npm/plugin versions match SBA 4.1.3's
             own build (and package.json matches its spring-boot-admin-sample-custom-ui), so the
             externalized Vue runtime lines up with what the SBA server ships. -->
        <node.version>v24.21.0</node.version>
        <npm.version>11.12.1</npm.version>
        <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>de.codecentric</groupId>
                <artifactId>spring-boot-admin-dependencies</artifactId>
                <version>${spring-boot-admin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
