<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.alexmond</groupId>
    <artifactId>spring-boot-admin-extensions</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>spring-boot-admin-extensions</name>
    <description>A small collection of extensions for Spring Boot Admin (SBA): custom UI pages
        shipped as classpath resource jars, and backend/SPI extensions such as a resilient
        Redis-backed InstanceEventStore. Drop the ones you want on the SBA server's classpath.</description>
    <url>https://github.com/alexmond/spring-boot-admin-extensions</url>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Alex Mondshain</name>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/alexmond/spring-boot-admin-extensions.git</connection>
        <developerConnection>scm:git:git@github.com:alexmond/spring-boot-admin-extensions.git</developerConnection>
        <url>https://github.com/alexmond/spring-boot-admin-extensions</url>
    </scm>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <modules>
        <module>sba-extension-environments</module>
        <module>sba-extension-live-metrics</module>
        <module>sba-extension-store-redis</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Spring Boot Admin server/client — tracks the Boot minor line (SBA 4.0.x ↔ Boot 4.0.x). -->
        <spring-boot-admin.version>4.0.4</spring-boot-admin.version>
        <!-- Frontend toolchain for the SBA UI extensions — versions match SBA 4.0.4's own build
             so the externalized Vue runtime lines up with what the SBA server ships. -->
        <node.version>v22.12.0</node.version>
        <frontend-maven-plugin.version>2.0.0</frontend-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>de.codecentric</groupId>
                <artifactId>spring-boot-admin-dependencies</artifactId>
                <version>${spring-boot-admin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
