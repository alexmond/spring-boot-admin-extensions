<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.alexmond</groupId>
        <artifactId>spring-boot-admin-extensions</artifactId>
        <version>4.1.1.2-SNAPSHOT</version>
    </parent>

    <artifactId>sba-extension-environments</artifactId>
    <name>sba-extension-environments</name>
    <description>SBA custom UI: an "Environments" page — the standard Applications view with an
        extra outer accordion level grouping apps by their info.tags.environment
        (environment → application → node). Reuses SBA's own components (sba-status, …) and
        the useApplicationStore data. Built with Vite/Vue and shipped as a resources jar under
        META-INF/spring-boot-admin-server-ui/extensions/environments.</description>

    <properties>
        <!-- This module has no Java code: skip the Java formatter and linters. -->
        <spring-javaformat.skip>true</spring-javaformat.skip>
        <checkstyle.skip>true</checkstyle.skip>
        <pmd.skip>true</pmd.skip>
    </properties>

    <build>
        <plugins>
            <!-- Build the Vue extension with a self-contained Node/npm (downloaded, not required
                 on PATH), then Vite bundles src/index.js -> target/dist/environments-ui.js. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <configuration>
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <installDirectory>${project.build.directory}</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                            <npmVersion>${npm.version}</npmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <!-- ci = reproducible install from the committed package-lock.json. -->
                            <arguments>ci --no-progress --no-audit --no-fund</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Copy the Vite bundle into the SBA extensions classpath location so the admin
                 server serves it. The 'environments' segment is this extension's folder name. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-ui-bundle</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/spring-boot-admin-server-ui/extensions/environments</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Maven Central requires a -sources and a -javadoc jar for every jar artifact. This
             module has no Java code, so the release attaches the Vue sources and a placeholder
             javadoc jar that says so. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>ui-sources-jar</id>
                                <phase>package</phase>
                                <goals><goal>jar</goal></goals>
                                <configuration>
                                    <classifier>sources</classifier>
                                    <classesDirectory>${project.basedir}</classesDirectory>
                                    <includes>
                                        <include>src/**</include>
                                        <include>package.json</include>
                                        <include>vite.config.js</include>
                                    </includes>
                                </configuration>
                            </execution>
                            <execution>
                                <id>placeholder-javadoc-jar</id>
                                <phase>package</phase>
                                <goals><goal>jar</goal></goals>
                                <configuration>
                                    <classifier>javadoc</classifier>
                                    <classesDirectory>${project.basedir}/src/javadoc</classesDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- The generic source/javadoc plugins have nothing to do here. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <configuration><skipSource>true</skipSource></configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration><skip>true</skip></configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
